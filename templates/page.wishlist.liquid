<div class="wishlist-page">
  <div class="container">
    <div class="wishlist-header">
      <h1 class="page-title">My Wishlist</h1>
      <p class="page-subtitle">Your favorite temporary tattoo designs</p>
    </div>
    
    <div id="wishlist-content">
      <div class="wishlist-empty" id="empty-wishlist">
        <div class="empty-icon">
          <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </div>
        <h3>Your wishlist is empty</h3>
        <p>Save your favorite tattoo designs by clicking the heart icon on any product.</p>
        <a href="/collections/all" class="btn-browse">Browse Tattoos</a>
      </div>
      
      <div class="wishlist-items" id="wishlist-items" style="display: none;">
        <div class="wishlist-grid"></div>
        <div class="wishlist-actions">
          <button id="clear-wishlist" class="btn-clear">Clear All</button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.wishlist-page {
  padding: 60px 0;
  min-height: 60vh;
  background: #ffffff;
}

.wishlist-header {
  text-align: center;
  margin-bottom: 50px;
}

.page-title {
  font-size: 48px;
  font-weight: 600;
  color: #2c2c2c;
  margin-bottom: 10px;
  font-family: var(--DTFontTypo_Heading);
}

.page-subtitle {
  font-size: 18px;
  color: #666666;
  margin: 0;
}

.wishlist-empty {
  text-align: center;
  padding: 80px 20px;
  max-width: 500px;
  margin: 0 auto;
}

.empty-icon {
  color: #666666;
  margin-bottom: 30px;
}

.wishlist-empty h3 {
  font-size: 24px;
  color: #2c2c2c;
  margin-bottom: 15px;
}

.wishlist-empty p {
  font-size: 16px;
  color: #666666;
  margin-bottom: 30px;
  line-height: 1.6;
}

.btn-browse {
  display: inline-block;
  background: #2c2c2c;
  color: #ffffff;
  padding: 15px 30px;
  text-decoration: none;
  font-weight: 500;
  transition: all 0.3s ease;
  border: 2px solid #2c2c2c;
}

.btn-browse:hover {
  background: #666666;
  border-color: #666666;
  color: #ffffff;
}

.wishlist-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 30px;
  margin-bottom: 40px;
}

.wishlist-item {
  border: 1px solid #eeeeee;
  background: #ffffff;
  transition: all 0.3s ease;
}

.wishlist-item:hover {
  box-shadow: 0 5px 20px rgba(0,0,0,0.1);
}

.wishlist-actions {
  text-align: center;
  padding-top: 30px;
  border-top: 1px solid #eeeeee;
}

.btn-clear {
  background: transparent;
  color: #666666;
  border: 2px solid #dddddd;
  padding: 12px 24px;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.btn-clear:hover {
  border-color: #666666;
  color: #2c2c2c;
}

@media (max-width: 768px) {
  .page-title {
    font-size: 32px;
  }
  
  .wishlist-grid {
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 20px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  loadWishlist();
  
  function loadWishlist() {
    const wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]');
    
    if (wishlist.length === 0) {
      document.getElementById('empty-wishlist').style.display = 'block';
      document.getElementById('wishlist-items').style.display = 'none';
    } else {
      document.getElementById('empty-wishlist').style.display = 'none';
      document.getElementById('wishlist-items').style.display = 'block';
      renderWishlistItems(wishlist);
    }
  }
  
  function renderWishlistItems(items) {
    const grid = document.querySelector('.wishlist-grid');
    grid.innerHTML = '';
    
    items.forEach(item => {
      const itemElement = document.createElement('div');
      itemElement.className = 'wishlist-item';
      itemElement.innerHTML = `
        <div style="position: relative; aspect-ratio: 1; overflow: hidden;">
          <img src="${item.image}" alt="${item.title}" style="width: 100%; height: 100%; object-fit: cover;">
          <button onclick="removeFromWishlist('${item.id}')" style="position: absolute; top: 10px; right: 10px; background: rgba(255,255,255,0.9); border: none; width: 36px; height: 36px; border-radius: 50%; cursor: pointer; color: #666666;">
            ×
          </button>
        </div>
        <div style="padding: 20px; text-align: center;">
          <h3 style="font-size: 16px; color: #2c2c2c; margin-bottom: 8px;">${item.title}</h3>
          <div style="font-size: 18px; font-weight: 600; color: #2c2c2c; margin-bottom: 15px;">${item.price}</div>
          <button onclick="addToCart('${item.id}')" style="background: #2c2c2c; color: #ffffff; border: 2px solid #2c2c2c; padding: 10px 20px; font-size: 14px; cursor: pointer; width: 100%; transition: all 0.3s ease;">Add to Cart</button>
        </div>
      `;
      grid.appendChild(itemElement);
    });
  }
  
  window.removeFromWishlist = function(productId) {
    let wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]');
    wishlist = wishlist.filter(item => item.id !== productId);
    localStorage.setItem('wishlist', JSON.stringify(wishlist));
    loadWishlist();
  }
  
  window.addToCart = function(productId) {
    console.log('Adding to cart:', productId);
  }
  
  document.getElementById('clear-wishlist').addEventListener('click', function() {
    if (confirm('Are you sure you want to clear your entire wishlist?')) {
      localStorage.removeItem('wishlist');
      loadWishlist();
    }
  });
});
</script>