<style>
  .tempoink-footer {
    padding: 3rem 2rem 2rem;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    background-color: #000000;
  }

  .tempoink-social {
    margin-bottom: 3rem;
  }

  .tempoink-social__heading {
    font-size: 1.2rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #FFFFFF;
    margin-bottom: 2rem;
  }

  .tempoink-social__links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .tempoink-social__link {
    color: #FFFFFF;
    font-size: 1.5rem;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
  }

  .tempoink-social__link:hover {
    background-color: #FFFFFF;
    color: #000000;
    border-color: #FFFFFF;
    transform: translateY(-2px);
  }

  .tempoink-powered {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.9rem;
    letter-spacing: 0.05em;
  }

  .tempoink-powered__link {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    transition: all 0.3s ease;
  }

  .tempoink-powered__link:hover {
    color: #FFFFFF;
    border-bottom-color: #FFFFFF;
  }

  @media (max-width: 768px) {
    .tempoink-footer {
      padding: 2rem 1rem 1.5rem;
    }

    .tempoink-social__links {
      gap: 1.5rem;
    }

    .tempoink-social__link {
      width: 45px;
      height: 45px;
      font-size: 1.3rem;
    }
  }
</style>

<footer class="tempoink-footer">
  {% if settings.pwd_show_share_buttons %}
    <div class="tempoink-social">
      <h3 class="tempoink-social__heading">{{ settings.pwd_social_message }}</h3>
      {% include 'social-sharing' %}
    </div>
  {% endif %}

  <div class="tempoink-powered">
    <small>Powered by Shopify</small>
  </div>
</footer>
