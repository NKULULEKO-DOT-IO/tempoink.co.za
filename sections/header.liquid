      {% assign isoSize = isoCode | size | minus: 1 %}   
      <li data-value="{{currency.iso_code}}">
        <label class="select-box__option" for="{{ forloop.index }}" aria-hidden="aria-hidden"><span  class="flag-icon flag-icon-{{ isoCode | slice: 0, isoSize }}"></span> {{ currency.iso_code }}</label>
      </li>
      {% endfor %}
    </ul>
  </div>
  <div class="custom-select hidden">
    <select name="currency">
      {% for currency in shop.enabled_currencies %}
      {% assign isoCode = currency.iso_code  | handle  %}
