      {% if currency == cart.currency %}
      <option selected="true" class="flag-icon flag-icon-{{ isoCode | slice: 0, isoSize }}">{{currency.iso_code}}</option>
      {% else %}
      <option class="flag-icon flag-icon-{{ isoCode | slice: 0, isoSize }}">{{currency.iso_code}}</option>
      {% endif %}
      {% endfor %}
