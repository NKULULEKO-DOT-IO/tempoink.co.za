}
  #shopify-section-{{section.id}}.home-support-block .custom-support-block .dt-sc-support-blocks-section .dt-sc-support-block .dt-sc-support-content .dt-sc-support-heading {
    font-size: var(--DTFontSize_H3);
    font-family: var(--DTFontTypo_Heading);
    margin-bottom: 20px;
    transition: var(--DTBaseTransition);
}
