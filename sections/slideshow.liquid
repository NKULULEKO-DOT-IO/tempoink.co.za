    color: #ffffff !important;
    opacity: 0.95;
    max-width: 90%;  /* Constrain width for better readability */
    margin-left: auto;
    margin-right: auto;
  }
  
  /* Better subheading styling */
  #shopify-section-{{section.id}}.home-slideshow-section .slider-{{ block.id }}-list .slide-sub-heading-2 {
    font-size: calc(.65* {{ block.settings.subheading_size }}px);
