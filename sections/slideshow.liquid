    text-transform: uppercase;
    color: #ffffff !important;
    opacity: 1;  /* Changed from 0.95 to full opacity */
    margin-bottom: 8px;
  }
  
  /* Ensure proper content centering */
  #shopify-section-{{section.id}}.home-slideshow-section .dt-sc-swiper-slider .swiper-wrapper .slider-content [class*="slide_"] {
