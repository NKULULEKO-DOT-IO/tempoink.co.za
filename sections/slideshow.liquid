  /* Image Overlay Styles */
  {% if section.settings.enable_overlay %}
  #shopify-section-{{section.id}} .dt-sc-swiper-slider .swiper-slide::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 5;
    pointer-events: none;
    background: linear-gradient(
      {{ section.settings.overlay_direction | default: 'to bottom' }},
      {{ section.settings.overlay_color_start | default: '#000000' | color_modify: 'alpha', section.settings.overlay_opacity | default: 0.7 }},
      {{ section.settings.overlay_color_end | default: '#000000' | color_modify: 'alpha', section.settings.overlay_opacity | default: 0.7 }}
    );
    border-radius: inherit;
  }
  
  /* Fallback overlay with simpler selector */
  #shopify-section-{{section.id}} .swiper-slide::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 5;
    pointer-events: none;
    background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | default: 0.1 }});
    border-radius: inherit;
  }

   /* Add mobile-specific overlay opacity */
  @media screen and (max-width: 576px) {
    #shopify-section-{{section.id}} .dt-sc-swiper-slider .swiper-slide::before {
      background: linear-gradient(
        {{ section.settings.overlay_direction | default: 'to bottom' }},
        {{ section.settings.overlay_color_start | default: '#000000' | color_modify: 'alpha', 0 }},  /* Changed from 0.3 to 0.2 */
        {{ section.settings.overlay_color_end | default: '#000000' | color_modify: 'alpha', 0 }}   /* Changed from 0.3 to 0.25 */
      ) !important;;
    }
