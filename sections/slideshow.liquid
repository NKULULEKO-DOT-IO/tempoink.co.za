    height: {{section.settings.slider_height_mobile}}px;
    object-position: center left !important;  /* Position image to center-left */
    object-fit: cover !important;
  }
  
  /* Ensure video also positions center-left */
  #shopify-section-{{section.id}}.home-slideshow-section .dt-sc-swiper-slider.swiper-container video {
    object-position: center left !important;
  }
    
    #shopify-section-{{section.id}} .swiper-slide::after {
      background: rgba(0, 0, 0, 0) !important;  /* Changed from 0.36 to 0.22 */
    }
    /* Tighter, cleaner text spacing */
  #shopify-section-{{section.id}}.home-slideshow-section .slider-{{ block.id }}-list .slide-text {
    font-size: 14px;
    font-weight: 400 !important;  /* Changed from 500 to 400 for lighter body text */
