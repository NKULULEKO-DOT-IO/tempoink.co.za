                    </g>
                    <g>
                      <path d="M500,465c-3.4,0-6.7-1.2-9.4-3.3l-250-200c-3.1-2.5-5.1-6.1-5.5-10.1c-0.4-4,0.7-7.9,3.2-11c2.9-3.6,7.1-5.6,11.7-5.6
                               c3.4,0,6.7,1.1,9.4,3.3L500,430.8l240.6-192.5c2.7-2.2,5.9-3.3,9.4-3.3c4.6,0,8.9,2.1,11.7,5.6c5.2,6.5,4.1,15.9-2.3,21.1l-250,200
                               C506.7,463.8,503.4,465,500,465z"/>
                    </g>
                    </svg></i>
                </div>
                <div class="dt-contact-icon-content">
                  <h5>{{ section.settings.contact_module_contact_title }}</h5>
                  <p> 
                    <a title="" href="">{{ section.settings.contact_module_email1 }}</a><br><a title="" href="">{{ section.settings.contact_module_email2 }}</a>
                  </p> 
                </div>
              </li>
              {% endif %}        
              {% if section.settings.contact_opening_hours %} 
              <li class="dt-contact-icon-block"> 
                <div class="dt-contact-icon-image">
                  <i><svg class="clock" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px"
                          viewBox="0 0 47.8 47.7" style="enable-background:new 0 0 47.8 47.7;" xml:space="preserve">
                    <circle class="cir1" cx="23.9" cy="7.1" r="1.4"/>
                    <circle  class="cir1"cx="40.9" cy="23.8" r="1.4"/>
                    <circle  class="cir1"cx="6.8" cy="23.8" r="1.4"/>
                    <circle  class="cir1"cx="23.9" cy="40.7" r="1.4"/>
                    <rect  class="cir1"x="23.1" y="11.7" width="1.6" height="13"/>
                    <rect  class="cir1" x="23.3" y="21" transform="matrix(0.7578 -0.6525 0.6525 0.7578 -7.7728 22.6874)" width="6.8" height="1.6"/>
                    <style>
                      .cir1{color:currentcolor;}
                      .clk0{color:transparent;}
                      .clock{border-radius:50%;border: 1px solid currentcolor;}
                      @media not all and (min-resolution:.001dpcm) { 
                        @supports (-webkit-appearance:none) {
                          .clk0{color:var(--DT_Button_Text_Color);}
                        }
                      }
                    </style></i>
                    </div> 
                  <div class="dt-contact-icon-content">
                    <h5>{{ section.settings.contact_opening__title }}</h5>
                    <p> {{ section.settings.contact_opening_hours1 }}<br /> {{ section.settings.contact_opening_hours2 }}<br />{{ section.settings.contact_opening_hours3 }}</p><mark></mark> 
                  </div>
                  </li>
            {% endif %}
          </ul>
          </div>
          {% endif %}
          
          {% if section.settings.enable_contact_form %}
          <div class="contact-form-section">
            <div class="form-hd">
            <h4> {{ section.settings.contact_form_title }} </h4>
            <p> {{ section.settings.title_description }}</p>
            </div>
            {% form 'contact' %}
            {% if form.posted_successfully? %}
            <p class="note form-success">
              {{ 'contact.form.post_success' | t }}
            </p>
            {% endif %}
            {{ form.errors | default_errors }}         
            <label for="ContactFormName" class="label--hidden">{{ 'contact.form.name' | t }}</label>
            <input type="text" id="ContactFormName" class="input-full" name="contact[name]" placeholder="{{ 'contact.form.name' | t }}" autocapitalize="words" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
            <label for="ContactFormEmail" class="label--hidden">{{ 'contact.form.email' | t }}</label>
            <input type="email" id="ContactFormEmail" class="input-full" name="contact[email]" placeholder="{{ 'contact.form.email' | t }}" autocorrect="off" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
            <label for="ContactFormPhone" class="label--hidden">{{ 'contact.form.phone' | t }}</label>
            <input type="tel" id="ContactFormPhone" class="input-full" name="contact[phone]" placeholder="{{ 'contact.form.phone' | t }}" pattern="[0-9\-]*" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}">
            <label for="ContactFormMessage" class="label--hidden">{{ 'contact.form.message' | t }}</label>
            <textarea rows="10" id="ContactFormMessage" class="input-full" name="contact[body]" placeholder="{{ 'contact.form.message' | t }}">{% if form.body %}{{ form.body }}{% endif %}</textarea>
            <button type="submit" class="btn">
              {{ 'contact.form.send' | t }} 
            </button>
            {% endform %}          
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>

  #shopify-section-{{section.id}}.contact-layout-3 .dt-sc-overlay:before  { 
    color: var(--DTTertiaryColor); 
      color: {{ section.settings.background_color }};    
      background: currentcolor; 
      opacity: {{ section.settings.overlay_transparency }}; }

  #shopify-section-contact .dt-sc-heading { margin-bottom: 35px; }
  #shopify-section-contact .dt-sc-heading .dt-sc-main-heading { color: var(--DTColor_Heading); color:{{ section.settings.section_heading_color }}; } 
  #shopify-section-contact .dt-sc-heading .dt-sc-sub-heading { color: var(--DTColor_Heading); color:{{ section.settings.section_sub_heading_color }}; } 
  #shopify-section-contact .dt-sc-heading .dt-sc-heading-description { color: var(--DTColor_Body);  color:{{ section.settings.section_description_color }}; } 
  #shopify-section-contact .dt-sc-heading .dt-sc-btn { 
    background: var(--DT_Button_BG_Color); background:{{ section.settings.section_button_bg_color }}; 
      color: var(--DT_Button_Text_Color); color:{{ section.settings.section_button_text_color }}; }
  #shopify-section-contact .dt-sc-heading .dt-sc-btn:hover { 
    background: var(--DT_Button_BG_Hover_Color); background:{{ section.settings.section_button_hover_bg_color }}; 
      color: var(--DT_Button_Text_Hover_Color); color:{{ section.settings.section_button_hover_text_color }}; }  

  #shopify-section-{{section.id}}.contact-layout-3  .dt-contact-iconblock-section { margin: 0; }
  #shopify-section-{{section.id}}.contact-layout-3 .dt-contact-iconblock-section .dt-contact-icon-block { 

    border-width: 1px; border-style: solid;
    border-color: {{ settings.border_color}};
    border-color: {{ section.settings.contactborder_color }}; 
    padding: 25px; 
    transition: var(--DTBaseTransition); 
      border-radius: var(--DTRadius);
        }

  #shopify-section-{{section.id}}.contact-layout-3 .dt-contact-iconblock-section .dt-contact-icon-block .dt-contact-icon-image > i { 
    background: var(--DT_Button_BG_Color);
      color: var(--DT_Button_Text_Color);
        background: {{ section.settings.contacticon_bg_color}}; 
        color:{{ section.settings.contacticon_color}};
        border-radius: var(--DTRadius);
          display: inline-block; 
          font-size: 20px; height: 50px; line-height: 50px; position: relative;text-align: center; width: 50px; transition: var(--DTBaseTransition); }
  #shopify-section-{{section.id}}.contact-layout-3  .dt-contact-iconblock-section .dt-contact-icon-block .dt-contact-icon-content br { display: block; margin-top: 6px; }

  #shopify-section-{{section.id}}.contact-layout-3  .dt-contact-iconblock-section .dt-contact-icon-block:hover { border-color: var(--DTPrimaryColor); border-color: {{ section.settings.contact_hvrborder_color }};}  
  #shopify-section-{{section.id}}.contact-layout-3   .dt-contact-iconblock-section .dt-contact-icon-block:hover .dt-contact-icon-image > i { 
    background: var(--DT_Button_BG_Hover_Color); background: {{ section.settings.contacticon_hoverbg_color}}; 
      color: var(--DT_Button_Text_Hover_Color); color:{{ section.settings.contacticonhover_color}}; 
        }
  #shopify-section-{{section.id}}.contact-layout-3   .dt-contact-iconblock-section .dt-contact-icon-block:hover .dt-contact-icon-image > i svg .cir1{color:{{ section.settings.contacticonhover_color}};transition: var(--DTBaseTransition); }
  #shopify-section-{{section.id}}.contact-layout-3  .dt-contact-iconblock-section .dt-contact-icon-block:hover .dt-contact-icon-image > i .clock{border: 1px solid {{ section.settings.contacticonhover_color}} ;transition: var(--DTBaseTransition); }
  #shopify-section-{{section.id}}.contact-layout-3   .dt-contact-iconblock-section .dt-contact-icon-block .dt-contact-icon-content h4 { 
    color: var(--DTColor_Heading); color: {{section.settings.icontactheading_color}}; margin-top: 25px; transition: var(--DTBaseTransition); } 
  #shopify-section-{{section.id}}.contact-layout-3   .dt-contact-iconblock-section .dt-contact-icon-block:hover .dt-contact-icon-content h4 { 
    color: var(--DTPrimaryColor); color: {{ section.settings.contacticon_hoverbg_color}}; }

  #shopify-section-{{section.id}}.contact-layout-3  .layout-type > .contact-form-section h4 { margin-top: 10px; }
  #shopify-section-{{section.id}}.contact-layout-3 .layout-type form.contact-form { display: grid; grid-template-columns: 1fr 1fr 1fr; column-gap: var(--DTGutter_Width); }
  #shopify-section-{{section.id}}.contact-layout-3 .layout-type form.contact-form > *{ margin-bottom:30px; }
  #shopify-section-{{section.id}}.contact-layout-3 .layout-type form.contact-form textarea#ContactFormMessage { grid-column: 1/4; border-radius: calc(.5 * var(--DT_Button_Border_Radius)) }
  #shopify-section-{{section.id}}.contact-layout-3 .layout-type form.contact-form button { grid-column: 2/3; margin: 0; } 

  #shopify-section-{{section.id}}.contact-layout-3 .layout-type form.contact-form .note.form-success { grid-column-start: 1; grid-column-end: 4; margin-bottom: 0; }


  #shopify-section-{{section.id}}.contact-layout-3  .layout-type { display: flex; flex-wrap: wrap; margin: 0 calc(-.5* var(--DTGutter_Width)); }
  #shopify-section-{{section.id}}.contact-layout-3  .layout-type > * { padding: calc(.5*var(--DTGutter_Width)); width: 100%; }



  /* Block Layout */
  #shopify-section-{{section.id}}.contact-layout-3   .layout-type.block_layout > * { flex: 1 1 100%; }
  #shopify-section-{{section.id}}.contact-layout-3  .layout-type.block_layout > * + * { margin-top: 35px; }


  /*  Left Icon Blocks + Map  */
  #shopify-section-{{section.id}}.contact-layout-3 .layout-type.left_iconblock_form_inline > * { flex: 1; }
  #shopify-section-{{section.id}}.contact-layout-3 .layout-type.left_iconblock_form_inline #map { flex: 1 1 100%; margin-bottom: 35px; order: 1; }  
  #shopify-section-{{section.id}}.contact-layout-3 .layout-type.left_iconblock_form_inline .contact-form-section { flex-grow: 1; order: 3; }
  #shopify-section-{{section.id}}.contact-layout-3 .layout-type.left_iconblock_form_inline .dt-contact-iconblock-section { order: 2; }

  #shopify-section-{{section.id}}.contact-layout-3 .layout-type.left_iconblock_form_inline > .contact-form-section h4 { margin-top: 0; margin-bottom: 12px; }

  #shopify-section-{{section.id}}.contact-layout-3 .layout-type.left_iconblock_form_inline > .dt-contact-iconblock-section + .contact-form-section form.contact-form > input, 
  #shopify-section-{{section.id}}.contact-layout-3 .layout-type.left_iconblock_form_inline > .dt-contact-iconblock-section + .contact-form-section form.contact-form textarea#ContactFormMessage { grid-column: 1/4; }

