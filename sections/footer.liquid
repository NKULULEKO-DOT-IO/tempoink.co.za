<!-- MINIMAL BLACK FOOTER FOR TEMPOINK -->
<footer class="site-footer minimal-black-footer" data-section-id="{{ section.id }}" data-section-type="footer-section">
  
  <!-- Main Footer Content -->
  <div class="footer-main">
    <div class="container">
      <div class="footer-content">
        
        <!-- Footer Links -->
        <div class="footer-links">
          <div class="footer-column">
            <h4>Shop</h4>
            <ul>
              <li><a href="/collections/all-tattoos">All Tattoos</a></li>
              <li><a href="/collections/new-tattoos">New Arrivals</a></li>
              <li><a href="/collections/best-sellers">Best Sellers</a></li>
              <li><a href="/collections/on-sale">On Sale</a></li>
              <li><a href="/collections/tattoo-packs">Tattoo Packs</a></li>
            </ul>
          </div>
          
          <div class="footer-column">
            <h4>Categories</h4>
            <ul>
              <li><a href="/collections/small-tattoos">Small Tattoos</a></li>
              <li><a href="/collections/medium-tattoos">Medium Tattoos</a></li>
              <li><a href="/collections/large-tattoos">Large Tattoos</a></li>
              <li><a href="/collections/sleeve-tattoos">Sleeve Tattoos</a></li>
            </ul>
          </div>
          
          <div class="footer-column">
            <h4>Support</h4>
            <ul>
              <li><a href="/pages/faqs">FAQ's</a></li>
              <li><a href="/pages/contact">Contact Us</a></li>
              <li><a href="/pages/shipping-returns">Shipping & Returns</a></li>
              <li><a href="/pages/size-guide">Size Guide</a></li>
            </ul>
          </div>
          
          <div class="footer-column">
            <h4>Company</h4>
            <ul>
              <li><a href="/pages/about-us">About Us</a></li>
              <li><a href="/pages/privacy-policy">Privacy Policy</a></li>
              <li><a href="/pages/terms-of-service">Terms of Service</a></li>
              <li><a href="/pages/refund-policy">Refund Policy</a></li>
            </ul>
          </div>
        </div>
        
        <!-- Newsletter Signup -->
        {% if section.settings.show_newsletter %}
        <div class="footer-newsletter">
          <h4>Stay Inked</h4>
          <p>Get the latest designs and exclusive offers</p>
          <form action="/contact#newsletter" method="post" class="newsletter-form">
            <input type="email" name="contact[email]" placeholder="Enter your email" required>
            <input type="hidden" name="contact[tags]" value="newsletter">
            <button type="submit">Subscribe</button>
          </form>
        </div>
        {% endif %}
        
      </div>
    </div>
  </div>
  
  <!-- Footer Bottom -->
  <div class="footer-bottom">
    <div class="container">
      <div class="footer-bottom-content">
        <div class="footer-copyright">
          <p>&copy; {{ 'now' | date: '%Y' }} <a href="/">TEMPOINK</a>. All rights reserved.</p>
        </div>
        
        {% if section.settings.show_social_links %}
        <div class="footer-social">
          {% if section.settings.facebook_url != blank %}
          <a href="{{ section.settings.facebook_url }}" aria-label="Facebook" target="_blank"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a>
          {% endif %}
          {% if section.settings.instagram_url != blank %}
          <a href="{{ section.settings.instagram_url }}" aria-label="Instagram" target="_blank"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg></a>
          {% endif %}
          {% if section.settings.tiktok_url != blank %}
          <a href="{{ section.settings.tiktok_url }}" aria-label="TikTok" target="_blank"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.321 5.562a5.124 5.124 0 0 1-.443-.258 6.228 6.228 0 0 1-1.137-.966c-.849-.964-1.341-2.192-1.341-3.338C16.4.567 15.833 0 15.4 0h-3.967c-.433 0-1 .567-1 1v10.089c0 1.743-1.342 3.161-2.99 3.161s-2.99-1.418-2.99-3.161c0-1.743 1.342-3.161 2.99-3.161.206 0 .405.021.598.059V4.484c-.193-.016-.39-.027-.598-.027C3.507 4.457 0 8.085 0 12.589c0 4.504 3.507 8.132 7.843 8.132 4.336 0 7.843-3.628 7.843-8.132V8.147a9.151 9.151 0 0 0 5.313 1.709V6.393a5.127 5.127 0 0 1-1.678-.831z"/></svg></a>
          {% endif %}
        </div>
        {% endif %}
      </div>
    </div>
  </div>

</footer>

<!-- MINIMAL BLACK FOOTER STYLES -->
<style>
.minimal-black-footer {
  background-color: #1a1a1a;
  color: #ffffff;
  margin-top: 60px;
}

.footer-main {
  padding: 60px 0 40px 0;
  border-bottom: 1px solid #333;
}

.footer-content {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 60px;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

.footer-links {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 40px;
}

.footer-column h4 {
  color: #ffffff;
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 20px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.footer-column ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-column ul li {
  margin-bottom: 12px;
}

.footer-column ul li a {
  color: #cccccc;
  text-decoration: none;
  font-size: 14px;
  transition: color 0.3s ease;
}

.footer-column ul li a:hover {
  color: #888;
}

.footer-newsletter {
  background: #222;
  padding: 30px;
  border-radius: 8px;
  height: fit-content;
}

.footer-newsletter h4 {
  color: #ffffff;
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 10px;
}

.footer-newsletter p {
  color: #cccccc;
  font-size: 14px;
  margin-bottom: 20px;
}

.newsletter-form {
  display: flex;
  gap: 0;
  align-items: center;
}

.newsletter-form input[type="email"] {
  flex: 1;
  padding: 14px 16px;
  border: 1px solid #444;
  background: #333;
  color: #ffffff;
  border-radius: 4px 0 0 4px;
  font-size: 14px;
  line-height: 1.2;
  box-sizing: border-box;
  border-right: none;
}

.newsletter-form input[type="email"]:focus {
  outline: none;
  border-color: #888;
}

.newsletter-form button {
  background: #888;
  color: white;
  border: 1px solid #888;
  padding: 14px 16px;
  border-radius: 0 4px 4px 0;
  cursor: pointer;
  font-size: 14px;
  font-weight: 500;
  line-height: 1.2;
  transition: background 0.3s ease;
  box-sizing: border-box;
}

.newsletter-form button:hover {
  background: #666;
}

.footer-bottom {
  padding: 20px 0;
}

.footer-bottom-content {
  display: flex;
  justify-content: center;
  align-items: center;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
  text-align: center;
}

.footer-copyright p {
  color: #888;
  font-size: 14px;
  margin: 0;
}

.footer-copyright a {
  color: #ffffff;
  text-decoration: none;
  font-weight: 600;
  transition: color 0.3s ease;
}

.footer-copyright a:hover {
  color: #cccccc;
}

.footer-social {
  display: flex;
  gap: 16px;
}

.footer-social a {
  color: #888;
  transition: color 0.3s ease;
}

.footer-social a:hover {
  color: #888;
}

/* Responsive Design */
@media (max-width: 768px) {
  .footer-content {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  
  .footer-links {
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
  }
  
  .footer-bottom-content {
    justify-content: center;
    text-align: center;
  }
}

@media (max-width: 480px) {
  .footer-links {
    grid-template-columns: 1fr;
    gap: 20px;
  }
  
  .footer-main {
    padding: 40px 0 30px 0;
  }
  
  .footer-newsletter {
    padding: 20px;
  }
  
  .newsletter-form {
    flex-direction: column;
  }
  
  .newsletter-form input[type="email"] {
    border-radius: 4px;
    margin-bottom: 8px;
  }
  
  .newsletter-form button {
    border-radius: 4px;
  }
}
</style>

{% schema %}
{
  "name": "Minimal Black Footer",
  "settings": [
    {
      "type": "header",
      "content": "Footer Settings"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show Newsletter Signup",
      "default": true
    },
    {
      "type": "header",
      "content": "Social Media Settings"
    },
    {
      "type": "checkbox",
      "id": "show_social_links",
      "label": "Show Social Links",
      "default": false
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    }
  ]
}
{% endschema %}