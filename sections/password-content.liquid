<style>
  .tempoink-content {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    background-color: #000000;
  }

  .tempoink-content__container {
    max-width: 600px;
    width: 100%;
  }

  .tempoink-password-message {
    color: rgba(255, 255, 255, 0.8);
    font-size: 1.1rem;
    line-height: 1.8;
    text-align: center;
    margin-bottom: 3rem;
  }

  .tempoink-newsletter {
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 3rem 2.5rem;
    border-radius: 2px;
  }

  .tempoink-newsletter__heading {
    font-size: 1.3rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    text-align: center;
    margin-bottom: 2rem;
    color: #FFFFFF;
    text-transform: uppercase;
  }

  .tempoink-form__success {
    list-style: none;
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 1.5rem;
    text-align: center;
    color: #FFFFFF;
    font-size: 1rem;
    letter-spacing: 0.05em;
  }

  .tempoink-form__errors {
    list-style: none;
    background-color: rgba(255, 0, 0, 0.1);
    border: 1px solid rgba(255, 0, 0, 0.3);
    padding: 1.5rem;
    margin-bottom: 2rem;
    color: #FFFFFF;
  }

  .tempoink-form__errors li {
    margin-bottom: 0.5rem;
  }

  .tempoink-form__errors li:last-child {
    margin-bottom: 0;
  }

  .tempoink-input-group {
    display: flex;
    gap: 0;
    margin-top: 2rem;
  }

  .tempoink-input-group__field {
    flex: 1;
    padding: 1rem 1.5rem;
    background-color: #FFFFFF;
    border: 1px solid #FFFFFF;
    color: #000000;
    font-size: 1rem;
    outline: none;
    transition: all 0.3s ease;
    border-radius: 0;
  }

  .tempoink-input-group__field::placeholder {
    color: rgba(0, 0, 0, 0.5);
  }

  .tempoink-input-group__field:focus {
    background-color: rgba(255, 255, 255, 0.95);
  }

  .tempoink-input-group__btn {
    display: flex;
  }

  .tempoink-btn {
    padding: 1rem 2.5rem;
    background-color: #000000;
    border: 1px solid #FFFFFF;
    color: #FFFFFF;
    font-size: 1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    font-weight: 500;
    white-space: nowrap;
  }

  .tempoink-btn:hover {
    background-color: #FFFFFF;
    color: #000000;
  }

  @media (max-width: 768px) {
    .tempoink-content {
      padding: 2rem 1rem;
    }

    .tempoink-newsletter {
      padding: 2rem 1.5rem;
    }

    .tempoink-input-group {
      flex-direction: column;
      gap: 1rem;
    }

    .tempoink-btn {
      width: 100%;
      padding: 1rem;
    }
  }
</style>

<main class="tempoink-content">
  <div class="tempoink-content__container">
    {% if settings.pwd_newsletter_enable %}
      <div class="tempoink-newsletter">
        {% form 'customer' %}
          {% if form.errors %}
            <ul class="tempoink-form__errors">
              {{ form.errors | default_errors }}
            </ul>
          {% endif %}

          {% if form.posted_successfully? %}
            <ul class="tempoink-form__success">
              <li>{{ 'general.password_page.signup_form_success' | t }}</li>
            </ul>
          {% else %}
            <h3 class="tempoink-newsletter__heading">{{ settings.pwd_newsletter_form_heading }}</h3>
            
            <input type="hidden" name="contact[tags]" value="prospect, password page">
            
            <div class="tempoink-input-group">
              <input type="email" 
                     name="contact[email]" 
                     id="Email" 
                     class="tempoink-input-group__field" 
                     placeholder="{{ settings.pwd_newsletter_placeholder }}"
                     required>
              <span class="tempoink-input-group__btn">
                <button type="submit" name="commit" class="tempoink-btn">
                  <span>{{ settings.pwd_newsletter_button_text }}</span>
                </button>
              </span>
            </div>
          {% endif %}
        {% endform %}
      </div>
    {% endif %}
  </div>
</main>
