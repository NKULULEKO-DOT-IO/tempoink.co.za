<style>
  .tempoink-header {
    padding: 3rem 2rem;
    text-align: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background-color: #000000;
  }

  .tempoink-header__logo-wrapper {
    margin-bottom: 2rem;
  }

  .tempoink-header__logo-link {
    display: inline-block;
    transition: opacity 0.3s ease;
  }

  .tempoink-header__logo-link:hover {
    opacity: 0.8;
  }

  .tempoink-header__logo-image {
    max-height: 100px;
    width: auto;
    display: block;
  }

  .tempoink-header__logo-text {
    font-size: 3rem;
    font-weight: 300;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #FFFFFF;
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .tempoink-header__title {
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.9);
    margin-top: 1.5rem;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .tempoink-header {
      padding: 2rem 1rem;
      margin-top: 4rem;
    }

    .tempoink-header__logo-text {
      font-size: 2rem;
      letter-spacing: 0.2em;
    }

    .tempoink-header__title {
      font-size: 1.2rem;
    }
  }
</style>

<header class="tempoink-header">
  <div class="tempoink-header__logo-wrapper">
    {% if settings.password_logo != blank %}
      <a href="/" class="tempoink-header__logo-link">   
        <img src="{{ settings.password_logo | img_url: 'x250' }}" 
             alt="{{ shop.name }}" 
             class="tempoink-header__logo-image">        
      </a>
    {% else %}
      <h1 class="tempoink-header__logo-text">{{ shop.name }}</h1>
    {% endif %}
  </div>

  {% if settings.pwd_header != blank %}
    <h2 class="tempoink-header__title">{{ settings.pwd_header }}</h2>
  {% endif %}
</header>
