    .layout-type.left_iconblock_form_inline > * { flex: auto; }

    .layout-type.block_layout .dt-contact-iconblock-section li,
    .layout-type.left_map_form_inline .dt-contact-iconblock-section li { flex: 1 1 40%; max-width: 50%; }

