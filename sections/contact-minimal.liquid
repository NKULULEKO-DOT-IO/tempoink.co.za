{% comment %}
  TEMPOINK Minimalistic Contact Page
  Version: 2.0 - Mobile-First | Black & White | Clean
{% endcomment %}

{% assign margin = section.settings.margin | split: ',' %}
{% assign margin_top = margin[0] %}
{% assign margin_bottom = margin[1] %}
{% assign padding = section.settings.padding | split: ',' %}
{% assign padding_top = padding[0] %}
{% assign padding_bottom = padding[1] %}

<div class="contact-minimal-wrapper" style="margin-top: {{ margin_top }}px; margin-bottom: {{ margin_bottom }}px; padding-top: {{ padding_top }}px; padding-bottom: {{ padding_bottom }}px;">
  <div class="{% if section.settings.full %}container-fluid{% else %}container{% endif %}">

    {%- comment -%} Page Header {%- endcomment -%}
    {% if section.settings.section_heading != blank or section.settings.section_sub_heading != blank %}
    <div class="contact-header">
      {% if section.settings.section_sub_heading != blank %}
        <p class="contact-subtitle">{{ section.settings.section_sub_heading }}</p>
      {% endif %}
      {% if section.settings.section_heading != blank %}
        <h1 class="contact-title">{{ section.settings.section_heading }}</h1>
      {% endif %}
      {% if section.settings.section_description != blank %}
        <p class="contact-description">{{ section.settings.section_description }}</p>
      {% endif %}
    </div>
    {% endif %}

    <div class="contact-content-grid">

      {%- comment -%} Contact Information Cards {%- endcomment -%}
      {% if section.settings.enable_contact_info %}
      <div class="contact-info-cards">

        {% if section.settings.contact_phone %}
        <div class="contact-card">
          <div class="contact-card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <h3 class="contact-card-title">{{ section.settings.contact_module_contact_phonetitle }}</h3>
          <div class="contact-card-content">
            {% if section.settings.contact_phone1 != blank %}
              <a href="tel:{{ section.settings.contact_phone1 | replace: ' ', '' | replace: '-', '' }}">{{ section.settings.contact_phone1 }}</a>
            {% endif %}
            {% if section.settings.contact_phone2 != blank %}
              <a href="tel:{{ section.settings.contact_phone2 | replace: ' ', '' | replace: '-', '' }}">{{ section.settings.contact_phone2 }}</a>
            {% endif %}
          </div>
        </div>
        {% endif %}

        {% if section.settings.contact_module_email %}
        <div class="contact-card">
          <div class="contact-card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <h3 class="contact-card-title">{{ section.settings.contact_module_contact_title }}</h3>
          <div class="contact-card-content">
            {% if section.settings.contact_module_email1 != blank %}
              <a href="mailto:{{ section.settings.contact_module_email1 }}">{{ section.settings.contact_module_email1 }}</a>
            {% endif %}
            {% if section.settings.contact_module_email2 != blank %}
              <a href="mailto:{{ section.settings.contact_module_email2 }}">{{ section.settings.contact_module_email2 }}</a>
            {% endif %}
          </div>
        </div>
        {% endif %}

        {% if section.settings.contact_module_address %}
        <div class="contact-card">
          <div class="contact-card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <h3 class="contact-card-title">{{ section.settings.contact_module_address_title }}</h3>
          <div class="contact-card-content">
            <p>
              {{ section.settings.contact_module_address1 }}<br>
              {{ section.settings.contact_module_address2 }}<br>
              {{ section.settings.postcode }}
            </p>
          </div>
        </div>
        {% endif %}

      </div>
      {% endif %}

      {%- comment -%} Contact Form {%- endcomment -%}
      {% if section.settings.enable_contact_form %}
      <div class="contact-form-wrapper">
        <div class="contact-form-container">

          {% if section.settings.contact_form_title != blank %}
            <h2 class="form-heading">{{ section.settings.contact_form_title }}</h2>
          {% endif %}

          {% if section.settings.contact_form_description != blank %}
            <p class="form-description">{{ section.settings.contact_form_description }}</p>
          {% endif %}

          {% form 'contact' %}
            {% if form.posted_successfully? %}
              <div class="form-message form-success">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <p>{{ 'contact.form.post_success' | t }}</p>
              </div>
            {% endif %}

            {% if form.errors %}
              <div class="form-message form-error">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="8" x2="12" y2="12"></line>
                  <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <div>{{ form.errors | default_errors }}</div>
              </div>
            {% endif %}

            <div class="form-grid">
              <div class="form-field">
                <label for="ContactFormName">Name <span class="required">*</span></label>
                <input
                  type="text"
                  id="ContactFormName"
                  name="contact[name]"
                  required
                  placeholder="Your full name"
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                >
              </div>

              <div class="form-field">
                <label for="ContactFormEmail">Email <span class="required">*</span></label>
                <input
                  type="email"
                  id="ContactFormEmail"
                  name="contact[email]"
                  required
                  placeholder="your@email.com"
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                >
              </div>

              <div class="form-field">
                <label for="ContactFormPhone">Phone</label>
                <input
                  type="tel"
                  id="ContactFormPhone"
                  name="contact[phone]"
                  placeholder="Your phone number"
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                >
              </div>

              <div class="form-field">
                <label for="ContactFormSubject">Subject</label>
                <input
                  type="text"
                  id="ContactFormSubject"
                  name="contact[subject]"
                  placeholder="What is this about?"
                >
              </div>

              <div class="form-field form-field-full">
                <label for="ContactFormMessage">Message <span class="required">*</span></label>
                <textarea
                  id="ContactFormMessage"
                  name="contact[body]"
                  rows="6"
                  required
                  placeholder="Tell us how we can help you..."
                >{% if form.body %}{{ form.body }}{% endif %}</textarea>
              </div>
            </div>

            <button type="submit" class="form-submit">
              <span>Send Message</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9"></polygon>
              </svg>
            </button>
          {% endform %}
        </div>
      </div>
      {% endif %}

    </div>

    {%- comment -%} Map Section {%- endcomment -%}
    {% if section.settings.enable_gmap and section.settings.contact_iframe_code != blank %}
    <div class="contact-map">
      {{ section.settings.contact_iframe_code }}
    </div>
    {% endif %}

  </div>
</div>

<style>
/* ========= MINIMALISTIC CONTACT PAGE STYLES ========= */

.contact-minimal-wrapper {
  background: var(--bg-primary, #FFFFFF);
  padding: clamp(48px, 8vw, 96px) 0;
}

/* === HEADER === */
.contact-header {
  text-align: center;
  max-width: 700px;
  margin: 0 auto 64px;
  padding: 0 16px;
}

.contact-subtitle {
  font-size: clamp(14px, 2vw, 16px);
  font-weight: 500;
  color: var(--text-secondary, #333333);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin: 0 0 12px 0;
}

.contact-title {
  font-size: clamp(32px, 6vw, 48px);
  font-weight: 700;
  color: var(--text-primary, #000000);
  margin: 0 0 16px 0;
  line-height: 1.2;
}

.contact-description {
  font-size: clamp(16px, 2vw, 18px);
  color: var(--text-secondary, #333333);
  line-height: 1.6;
  margin: 0;
}

/* === CONTENT GRID === */
.contact-content-grid {
  display: grid;
  gap: 48px;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 16px;
}

@media (min-width: 1024px) {
  .contact-content-grid {
    grid-template-columns: 1fr 1.5fr;
    gap: 64px;
  }
}

/* === CONTACT INFO CARDS === */
.contact-info-cards {
  display: grid;
  gap: 24px;
}

.contact-card {
  background: var(--bg-primary, #FFFFFF);
  border: 2px solid var(--color-gray-border, #E0E0E0);
  padding: 32px 24px;
  transition: border-color 0.2s ease;
}

.contact-card:hover {
  border-color: var(--color-black, #000000);
}

.contact-card-icon {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-black, #000000);
  margin-bottom: 20px;
}

.contact-card-icon svg {
  stroke: var(--color-white, #FFFFFF);
}

.contact-card-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--text-primary, #000000);
  margin: 0 0 12px 0;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.contact-card-content {
  font-size: 16px;
  line-height: 1.6;
}

.contact-card-content a {
  color: var(--text-secondary, #333333);
  text-decoration: none;
  display: block;
  margin-bottom: 4px;
  transition: color 0.2s ease;
}

.contact-card-content a:hover {
  color: var(--color-black, #000000);
}

.contact-card-content p {
  color: var(--text-secondary, #333333);
  margin: 0;
}

/* === CONTACT FORM === */
.contact-form-wrapper {
  background: var(--bg-secondary, #F5F5F5);
  border: 2px solid var(--color-gray-border, #E0E0E0);
  padding: clamp(32px, 5vw, 48px);
}

.form-heading {
  font-size: clamp(24px, 4vw, 32px);
  font-weight: 700;
  color: var(--text-primary, #000000);
  margin: 0 0 12px 0;
}

.form-description {
  font-size: 16px;
  color: var(--text-secondary, #333333);
  line-height: 1.6;
  margin: 0 0 32px 0;
}

.form-grid {
  display: grid;
  gap: 20px;
  margin-bottom: 24px;
}

@media (min-width: 640px) {
  .form-grid {
    grid-template-columns: 1fr 1fr;
  }
}

.form-field {
  display: flex;
  flex-direction: column;
}

.form-field-full {
  grid-column: 1 / -1;
}

.form-field label {
  font-size: 14px;
  font-weight: 500;
  color: var(--text-primary, #000000);
  margin-bottom: 8px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.required {
  color: var(--text-primary, #000000);
}

.form-field input,
.form-field textarea {
  font-size: 16px !important; /* Prevents iOS zoom */
  font-family: var(--DTFontTypo_Body, 'Roboto', sans-serif);
  background: var(--bg-primary, #FFFFFF);
  border: 2px solid var(--color-gray-border, #E0E0E0);
  color: var(--text-primary, #000000);
  padding: 14px 16px;
  transition: border-color 0.2s ease;
  border-radius: 0;
}

.form-field input:focus,
.form-field textarea:focus {
  border-color: var(--color-black, #000000);
  outline: none;
}

.form-field input::placeholder,
.form-field textarea::placeholder {
  color: #999999;
}

.form-field textarea {
  resize: vertical;
  min-height: 120px;
}

/* === FORM SUBMIT BUTTON === */
.form-submit {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  background: var(--color-black, #000000);
  color: var(--color-white, #FFFFFF);
  border: 2px solid var(--color-black, #000000);
  padding: 16px 32px;
  font-size: 16px;
  font-weight: 500;
  font-family: var(--DTFontTypo_Body, 'Roboto', sans-serif);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  cursor: pointer;
  transition: all 0.2s ease;
  min-height: 56px;
}

.form-submit:hover {
  background: var(--color-white, #FFFFFF);
  color: var(--color-black, #000000);
}

.form-submit svg {
  stroke: currentColor;
  transition: transform 0.2s ease;
}

.form-submit:hover svg {
  transform: translateX(4px);
}

/* === FORM MESSAGES === */
.form-message {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 16px 20px;
  margin-bottom: 24px;
  border: 2px solid;
}

.form-success {
  background: #F5F5F5;
  border-color: var(--color-black, #000000);
  color: var(--text-primary, #000000);
}

.form-error {
  background: #F5F5F5;
  border-color: var(--color-black, #000000);
  color: var(--text-primary, #000000);
}

.form-message p {
  margin: 0;
  font-size: 14px;
  font-weight: 500;
}

.form-message svg {
  flex-shrink: 0;
  margin-top: 2px;
}

/* === MAP === */
.contact-map {
  margin-top: 64px;
  border: 2px solid var(--color-gray-border, #E0E0E0);
  overflow: hidden;
  height: 400px;
}

.contact-map iframe {
  width: 100%;
  height: 100%;
  border: none;
  display: block;
}

@media (min-width: 768px) {
  .contact-map {
    height: 500px;
  }
}

/* === MOBILE OPTIMIZATIONS === */
@media (max-width: 767px) {
  .contact-minimal-wrapper {
    padding: 48px 0;
  }

  .contact-header {
    margin-bottom: 40px;
  }

  .contact-content-grid {
    gap: 32px;
  }

  .contact-card {
    padding: 24px 20px;
  }

  .form-submit {
    font-size: 14px;
  }
}
</style>

{% schema %}
{
  "name": "Contact (Minimal)",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "checkbox",
      "id": "full",
      "label": "Full Width",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "spacing_both_ends",
      "label": "Spacing Both Ends",
      "default": true
    },
    {
      "type": "text",
      "id": "padding",
      "label": "Padding (Top,Bottom)",
      "default": "0,0"
    },
    {
      "type": "text",
      "id": "margin",
      "label": "Margin (Top,Bottom)",
      "default": "0,0"
    },
    {
      "type": "header",
      "content": "Page Header"
    },
    {
      "type": "text",
      "id": "section_sub_heading",
      "label": "Subtitle",
      "default": "Get in Touch"
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Heading",
      "default": "Contact Us"
    },
    {
      "type": "textarea",
      "id": "section_description",
      "label": "Description",
      "default": "Have questions about our temporary tattoos? We're here to help! Reach out to us anytime."
    },
    {
      "type": "header",
      "content": "Contact Information"
    },
    {
      "type": "checkbox",
      "id": "enable_contact_info",
      "label": "Show Contact Info Cards",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "contact_phone",
      "label": "Show Phone",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_module_contact_phonetitle",
      "label": "Phone Title",
      "default": "Phone"
    },
    {
      "type": "text",
      "id": "contact_phone1",
      "label": "Phone Number 1",
      "default": "+27 123 456 789"
    },
    {
      "type": "text",
      "id": "contact_phone2",
      "label": "Phone Number 2"
    },
    {
      "type": "checkbox",
      "id": "contact_module_email",
      "label": "Show Email",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_module_contact_title",
      "label": "Email Title",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "contact_module_email1",
      "label": "Email Address 1",
      "default": "hello@tempoink.co.za"
    },
    {
      "type": "text",
      "id": "contact_module_email2",
      "label": "Email Address 2"
    },
    {
      "type": "checkbox",
      "id": "contact_module_address",
      "label": "Show Address",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_module_address_title",
      "label": "Address Title",
      "default": "Address"
    },
    {
      "type": "text",
      "id": "contact_module_address1",
      "label": "Address Line 1",
      "default": "123 Tattoo Street"
    },
    {
      "type": "text",
      "id": "contact_module_address2",
      "label": "Address Line 2",
      "default": "Durban, KwaZulu-Natal"
    },
    {
      "type": "text",
      "id": "postcode",
      "label": "Postal Code",
      "default": "4001"
    },
    {
      "type": "header",
      "content": "Contact Form"
    },
    {
      "type": "checkbox",
      "id": "enable_contact_form",
      "label": "Show Contact Form",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_form_title",
      "label": "Form Heading",
      "default": "Send Us a Message"
    },
    {
      "type": "textarea",
      "id": "contact_form_description",
      "label": "Form Description",
      "default": "Fill out the form below and we'll get back to you within 24 hours."
    },
    {
      "type": "header",
      "content": "Map"
    },
    {
      "type": "checkbox",
      "id": "enable_gmap",
      "label": "Show Map",
      "default": false
    },
    {
      "type": "html",
      "id": "contact_iframe_code",
      "label": "Map Embed Code (iframe)"
    }
  ],
  "presets": [
    {
      "name": "Contact (Minimal)",
      "category": "Contact"
    }
  ]
}
{% endschema %}
