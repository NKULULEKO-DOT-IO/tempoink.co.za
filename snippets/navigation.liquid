{%- assign dt_mega = false -%}
{%- assign primary = false -%}
{%- if link.levels == 1 -%}
{%- assign primary = true -%}
{%- endif -%}
{%- assign secondary = false -%}
{%- if link.levels == 2 -%}
{%- assign secondary = true -%}
{%- endif -%}

{% if section.settings.enable_new %}
{% assign new_tag =  section.settings.new_tags | split:"," | strip | downcase | handle %} 
{% assign new_label = section.settings.new_txt %}
{% endif %}

{% if section.settings.enable_sale %}
{% assign sale_tag = section.settings.sale_tags | split:"," | strip | downcase | handle %} 
{% assign sale_label = section.settings.sale_txt %}
{% endif %}

{% if section.settings.enable_hot %}
{% assign hot_tag = section.settings.hot_tags | split:"," | strip | downcase | handle %} 
{% assign hot_label = section.settings.hot_txt %}
{% endif %}



{%- for block in section.blocks -%} 
{% for i in (1..5) %}
{%- assign megamenu_title = '' -%}
{%- assign link_title = link.title | escape | strip | handleize -%}
{%- assign dt_menu_pick = i | prepend: 'mega_' -%}
{% if block.settings[dt_menu_pick] != blank %}
{% assign megamenu_title = block.settings[dt_menu_pick] | handleize %}

{%- if  link_title == megamenu_title -%}
{% assign columnSize = block.settings.mega_columns %} 
{% if  block.settings.row_reverse %}
{% assign reverse = true %}
{% endif %}



{% assign blockType = block.type %}

{%- assign dt_mega = true -%}

{%- capture megaPromo -%}
{% render 'dt-megaPromo', block: block %}
{%- endcapture -%}

{%- capture megaBanner1 -%}
{% render 'dt-megaBanner-1', block: block %}
{%- endcapture -%}

{%- capture shopBrands -%}
{% render 'dt-megaBrands', block: block %}
{%- endcapture -%}

{%- capture megaBanner2 -%}
{% render 'dt-megaBanner-2', block: block %}
{%- endcapture -%}
<!-- Product -->
{%- capture megaProduct -%}
{% render 'dt-megaProduct', block: block %}
{%- endcapture -%}
<!-- Product End -->

{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- endfor -%}

{%- comment -%} DEMO MEGA MENUS FOR MULTIPLE ITEMS {%- endcomment -%}
{%- if link_title == 'catalog' or link_title == 'categories' -%}
{% assign columnSize = 'four-column' %} 
{% assign blockType = 'demo_menu' %}
{%- assign dt_mega = true -%}
{%- endif -%}

{%- comment -%} TATTOOS DROPDOWN MENU {%- endcomment -%}
{%- if link_title == 'tattoos' -%}
{% assign columnSize = 'three-column' %} 
{% assign blockType = 'tattoo_menu' %}
{%- assign dt_mega = true -%}
{%- endif -%}

<li class="{{link.levels}} {% if blockType == "promo_image" %}promo_image{% elsif blockType == "product" %}megaProduct{% elsif blockType == "promo_banner" %}promo_banner{% else %}text-menu{% endif %}
           top-level-link 
           {% if dt_mega %} has-mega-menu dt-sc-primary
           {% elsif secondary %} dt-sc-secondary
           {% else %} dt-sc-child
           {%endif%}
           {% if link.active %}active{% endif %} {% if primary or secondary or dt_mega %}menu-item-has-children{% endif %}">
  <a href="{{ link.url }}" class=" {% if dt_mega %}mega-menu{% endif %} dt-sc-nav-link dropdown"> 

    <span>
      {{ link.title | escape }} 
      {% assign mainTag = link.handle  %}   
      {% if sale_tag contains mainTag %}
      <em class="sale tag">{{ sale_label }}</em>
      {% elsif new_tag contains mainTag %}
      <em class="new tag">{{ new_label }}</em>
      {% elsif hot_tag contains mainTag %}
      <em class="hot tag">{{ hot_label }}</em>
      {% endif %}     
    </span>

    {%- if section.settings.enable_menu_indicator -%}
    {% if primary or secondary or dt_mega %}<span class="dt-sc-caret"></span>
    {% endif %}
    {% endif %}

  </a>

  {% if  dt_mega %}
  <div class="sub-menu-block is-hidden">
    <div class="go-back">
      <a href="javascript:void(0);"></a>
    </div>
    <div class="see-all"></div>
    <div class="dt-sc-dropdown-menu{% if dt_mega %} dt-sc--main-menu--mega{% endif %} {% if primary or secondary %} dt-sc_main-menu--has-links{% endif %}">

      <ul class="sub-menu-lists {% if dt_mega %} dt-sc-column  {{columnSize}}  {% if reverse %}row-reverse{% endif %} {% endif %} ">        

        {% if blockType == "promo_banner"  %}
        {{ megaBanner1 }}
        {% endif %}

        {%- if link.links != blank -%}
        {%- for child_link in link.links  limit: 5  -%}
        <li class="{% if child_link.active %}active{% endif %}">
          <h5> <a href="{{ child_link.url }}" {% if child_link.active %}aria-current="page"{% endif %}>
            {{ child_link.title }}
            </a>
          </h5>
          {%- if child_link.links != blank -%}
          <ul>
            {%- for grandchild_link in child_link.links -%}
            <li class="{% if grandchild_link.active %}active{% endif %}">
              <a href="{{ grandchild_link.url }}" {% if grandchild_link.active %}aria-current="page"{% endif %}>
                <span>
                  {{ grandchild_link.title }}   

                  {% assign mapTag = grandchild_link.handle  %}

                  {% if sale_tag contains mapTag %}
                  <em class="tag sale">{{ sale_label }}</em>
                  {% endif %}

                  {% if new_tag contains mapTag %}
                  <em class="tag new">{{ new_label }}</em>
                  {% endif %}

                  {% if hot_tag contains mapTag %}
                  <em class="tag hot">{{ hot_label }}</em>
                  {% endif %}
                </span>
              </a>
            </li>
            {%- endfor -%}
          </ul>
          {%- endif -%}
        </li>
        {%- endfor -%}              
        {% endif %}  


        {% if blockType == "promo_image" %}
        {{ megaPromo }}
        {% endif %}       
        {% if blockType == "product" %} 
        {{ megaProduct }}
        {% endif %}


        {% if blockType == "promo_banner"  %}    
        {{ megaBanner2 }}      
        {% endif %}

        {% if blockType == "demo_menu" %}
        <!-- DEMO MEGA MENU CONTENT -->
        <li>
          <h5><a href="/collections/by-size">By Size</a></h5>
          <ul>
            <li><a href="/collections/extra-small"><span>Extra Small</span></a></li>
            <li><a href="/collections/small"><span>Small</span></a></li>
            <li><a href="/collections/medium"><span>Medium</span></a></li>
            <li><a href="/collections/large"><span>Large</span></a></li>
            <li><a href="/collections/sleeve"><span>Sleeve</span></a></li>
          </ul>
        </li>
        <li>
          <h5><a href="/collections/by-style">By Style</a></h5>
          <ul>
            <li><a href="/collections/traditional"><span>Traditional</span></a></li>
            <li><a href="/collections/japanese"><span>Japanese</span></a></li>
            <li><a href="/collections/minimal"><span>Minimal</span></a></li>
            <li><a href="/collections/blackwork"><span>Blackwork</span></a></li>
            <li><a href="/collections/fineline"><span>Fineline</span></a></li>
          </ul>
        </li>
        <li>
          <h5><a href="/collections/by-product">By Product</a></h5>
          <ul>
            <li><a href="/collections/new"><span>New Arrivals</span></a></li>
            <li><a href="/collections/best-sellers"><span>Best Sellers</span></a></li>
            <li><a href="/collections/on-sale"><span>On Sale</span></a></li>
            <li><a href="/collections/tattoo-packs"><span>Tattoo Packs</span></a></li>
            <li><a href="/collections/all"><span>Shop All</span></a></li>
          </ul>
        </li>
        <li class="mega-menu-promo">
          <h4>MORE INK MORE SAVINGS</h4>
          <p>Spend R750 or more to unlock a FREE exclusive tattoo pack (including 4 free tattoos and free shipping).</p>
          <a href="/collections/all" class="btn">SAVE NOW →</a>
        </li>
        {% endif %}

        {% if blockType == "tattoo_menu" %}
        <!-- TATTOOS MEGA MENU CONTENT -->
        <li>
          <h5><a href="/collections/by-size">By Size</a></h5>
          <ul>
            <li><a href="/collections/extra-small"><span>Extra Small</span></a></li>
            <li><a href="/collections/small"><span>Small</span></a></li>
            <li><a href="/collections/medium"><span>Medium</span></a></li>
            <li><a href="/collections/large"><span>Large</span></a></li>
            <li><a href="/collections/sleeve"><span>Sleeve</span></a></li>
            <li><a href="/collections/all-sizes"><span>Shop All</span></a></li>
          </ul>
        </li>
        <li>
          <h5><a href="/collections/by-product">By Product</a></h5>
          <ul>
            <li><a href="/collections/new"><span>New</span></a></li>
            <li><a href="/collections/best-sellers"><span>Best Sellers</span></a></li>
            <li><a href="/collections/on-sale"><span>On Sale</span></a></li>
            <li><a href="/collections/tattoo-packs"><span>Tattoo Packs</span></a></li>
            <li><a href="/collections/all"><span>Shop All</span></a></li>
          </ul>
        </li>
        <li>
          <h5><a href="/collections/by-style">By Style</a></h5>
          <ul>
            <li><a href="/collections/traditional"><span>Traditional</span></a></li>
            <li><a href="/collections/japanese"><span>Japanese</span></a></li>
            <li><a href="/collections/minimal"><span>Minimal</span></a></li>
            <li><a href="/collections/patchwork"><span>Patchwork</span></a></li>
            <li><a href="/collections/blackwork"><span>Blackwork</span></a></li>
            <li><a href="/collections/fineline"><span>Fineline</span></a></li>
            <li><a href="/collections/cute"><span>Cute</span></a></li>
            <li><a href="/collections/astrology"><span>Astrology</span></a></li>
            <li><a href="/collections/realism"><span>Realism</span></a></li>
            <li><a href="/collections/american"><span>American</span></a></li>
            <li><a href="/collections/all-styles"><span>Shop All</span></a></li>
          </ul>
        </li>
        {% endif %}

      </ul>


      {% if blockType == "brands"  %}
      <ul class="sub-menu-lists mega-menu-brands">
        {{shopBrands }}
      </ul>
      {% endif %}
    </div> 
  </div>
  {% else %}
  {%- if link.links != blank -%}
  <div class="sub-menu-block is-hidden">
    <div class="go-back">
      <a href="javascript:void(0);"></a>
    </div>
    <div class="see-all"></div>
    <div class="dt-sc-dropdown-menu{% if primary or secondary %} dt-sc_main-menu--has-links{% endif %}">
      <ul class="sub-menu-lists">

        {%- for child_link in link.links -%}
        <li class="{% if primary or secondary %}  {%- if child_link.links != blank -%}menu-item-has-children{% endif %}{% endif %}{% if child_link.active %} active{% endif %}">
          <a href="{{ child_link.url }}" {% if child_link.active %}aria-current="page"{% endif %}>
            {{ child_link.title }}
          </a>

          {%- if child_link.links != blank -%}
          <div class="sub-menu-block is-hidden">
            <div class="go-back">
              <a href="javascript:void(0);"></a>
            </div>
            <div class="see-all"></div>
            <div class="dt-sc_main-menu--has-links">
              <ul class="sub-menu-lists">
                {%- for grandchild_link in child_link.links -%}
                <li class="{% if grandchild_link.active %} active{% endif %}">
                  <a href="{{ grandchild_link.url }}" {% if grandchild_link.active %}aria-current="page"{% endif %}>
                    {{ grandchild_link.title }}
                  </a>
                </li>
                {%- endfor -%}
              </ul>
            </div>
          </div>
          {%- endif -%}
        </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>  
  {% endif %}
  {%- endif -%}
</li>
