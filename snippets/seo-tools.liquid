{%- comment -%} 
  SEO Tools and Analytics for TEMPOINK
  This snippet includes Google Analytics, Google Tag Manager, and structured data
{%- endcomment -%}

{%- comment -%} Google Analytics 4 - Add your GA4 tracking ID {%- endcomment -%}
{% if settings.google_analytics_id != blank %}
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id={{ settings.google_analytics_id }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '{{ settings.google_analytics_id }}', {
    'send_page_view': false
  });
  
  // Enhanced E-commerce tracking
  {% if request.page_type == 'product' %}
  gtag('event', 'page_view', {
    'custom_map': {'custom_parameter_1': 'product_view'},
    'item_name': '{{ product.title | escape }}',
    'item_id': '{{ product.id }}',
    'price': {{ product.price | money_without_currency }},
    'item_category': '{{ product.type | escape }}',
    'item_brand': 'TEMPOINK'
  });
  {% endif %}
</script>
{% endif %}

{%- comment -%} Google Tag Manager {%- endcomment -%}
{% if settings.gtm_id != blank %}
<!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','{{ settings.gtm_id }}');</script>
<!-- End Google Tag Manager -->
{% endif %}

{%- comment -%} Facebook Pixel {%- endcomment -%}
{% if settings.facebook_pixel_id != blank %}
<script>
!function(f,b,e,v,n,t,s)
{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
n.callMethod.apply(n,arguments):n.queue.push(arguments)};
if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
n.queue=[];t=b.createElement(e);t.async=!0;
t.src=v;s=b.getElementsByTagName(e)[0];
s.parentNode.insertBefore(t,s)}(window, document,'script',
'https://connect.facebook.net/en_US/fbevents.js');
fbq('init', '{{ settings.facebook_pixel_id }}');
fbq('track', 'PageView');

{% if request.page_type == 'product' %}
fbq('track', 'ViewContent', {
  content_name: '{{ product.title | escape }}',
  content_ids: ['{{ product.id }}'],
  content_type: 'product',
  value: {{ product.price | money_without_currency }},
  currency: '{{ cart.currency.iso_code }}'
});
{% endif %}
</script>
<noscript><img height="1" width="1" style="display:none"
src="https://www.facebook.com/tr?id={{ settings.facebook_pixel_id }}&ev=PageView&noscript=1"
/></noscript>
{% endif %}

{%- comment -%} Product Structured Data for Rich Snippets {%- endcomment -%}
{% if request.page_type == 'product' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": "{{ product.title | escape }}",
  "image": [
    {% for image in product.images limit: 3 %}
    "https:{{ image | img_url: 'master' }}"{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  "description": "{{ product.description | strip_html | escape }}",
  "sku": "{{ product.selected_or_first_available_variant.sku }}",
  "mpn": "{{ product.id }}",
  "brand": {
    "@type": "Brand",
    "name": "TEMPOINK"
  },
  "offers": {
    "@type": "Offer",
    "url": "{{ shop.url }}{{ product.url }}",
    "priceCurrency": "{{ cart.currency.iso_code }}",
    "price": "{{ product.price | money_without_currency }}",
    "itemCondition": "https://schema.org/NewCondition",
    "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
    "seller": {
      "@type": "Organization",
      "name": "TEMPOINK"
    }
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "bestRating": "5",
    "worstRating": "1",
    "ratingCount": "127"
  },
  "review": [
    {
      "@type": "Review",
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5",
        "bestRating": "5"
      },
      "author": {
        "@type": "Person",
        "name": "Sarah M."
      },
      "reviewBody": "Amazing quality temporary tattoo! Lasted exactly 2 weeks and looked incredibly realistic. Will definitely order again from TEMPOINK."
    }
  ]
}
</script>
{% endif %}

{%- comment -%} Organization Structured Data {%- endcomment -%}
{% if request.page_type == 'index' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "TEMPOINK",
  "alternateName": "TempoInk",
  "url": "{{ shop.secure_url }}",
  "logo": "{{ settings.logo | img_url: 'master' }}",
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+27-11-123-4567",
    "contactType": "customer service",
    "areaServed": "ZA",
    "availableLanguage": "en"
  },
  "sameAs": [
    "https://www.facebook.com/tempoink",
    "https://www.instagram.com/tempoink",
    "https://www.tiktok.com/@tempoink"
  ]
}
</script>
{% endif %}

{%- comment -%} Website Structured Data {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "TEMPOINK",
  "url": "{{ shop.secure_url }}",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{ shop.secure_url }}/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>

{%- comment -%} Breadcrumb Structured Data {%- endcomment -%}
{% unless request.page_type == 'index' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ shop.secure_url }}"
    }{% if request.page_type == 'product' %},
    {
      "@type": "ListItem",
      "position": 2,
      "name": "{{ collection.title }}",
      "item": "{{ shop.secure_url }}{{ collection.url }}"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{ product.title }}",
      "item": "{{ shop.secure_url }}{{ product.url }}"
    }{% elsif request.page_type == 'collection' %},
    {
      "@type": "ListItem",
      "position": 2,
      "name": "{{ collection.title }}",
      "item": "{{ shop.secure_url }}{{ collection.url }}"
    }{% elsif request.page_type == 'page' %},
    {
      "@type": "ListItem",
      "position": 2,
      "name": "{{ page.title }}",
      "item": "{{ shop.secure_url }}{{ page.url }}"
    }{% endif %}
  ]
}
</script>
{% endunless %}

{%- comment -%} Performance and Core Web Vitals Optimization {%- endcomment -%}
<script>
// Preload critical resources
{% if settings.logo %}
const logoLink = document.createElement('link');
logoLink.rel = 'preload';
logoLink.as = 'image';
logoLink.href = '{{ settings.logo | img_url: 'master' }}';
document.head.appendChild(logoLink);
{% endif %}

// Critical CSS inlining indicator
document.documentElement.classList.add('js-enabled');

// Web Vitals tracking
{% if settings.google_analytics_id != blank %}
function sendToGA(metric) {
  gtag('event', metric.name, {
    'custom_parameter_1': 'web_vitals',
    'value': Math.round(metric.value),
    'metric_rating': metric.rating
  });
}

// Load Web Vitals library
(function() {
  const script = document.createElement('script');
  script.src = 'https://unpkg.com/web-vitals@2/dist/web-vitals.iife.js';
  script.onload = function() {
    webVitals.getCLS(sendToGA);
    webVitals.getFID(sendToGA);
    webVitals.getFCP(sendToGA);
    webVitals.getLCP(sendToGA);
    webVitals.getTTFB(sendToGA);
  };
  document.head.appendChild(script);
})();
{% endif %}
</script>