<!doctype html>
<!--[if IE 9]> <html class="ie9 no-js" lang="{{ shop.locale }}"> <![endif]-->
<!--[if (gt IE 9)|!(IE)]><!--> <html class="no-js" lang="{{ shop.locale }}"> <!--<![endif]-->
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#000000">
  <link rel="canonical" href="{{ canonical_url }}">

  {% if settings.favicon != blank %}
  <link rel="shortcut icon" href="{{ settings.favicon | img_url: '32x32' }}" type="image/png">
  {% endif %}

  <title>
    {{ shop.name }} &ndash; {{ 'general.password_page.opening_soon' | t }}
  </title>

  {% if page_description %}
  <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  {% include 'social-meta-tags' %}
  {{ 'dt-framework.css' | asset_url | stylesheet_tag }} 
  {{ 'dt-custom.css' | asset_url | stylesheet_tag }}
  {{ 'font-all.min.css' | asset_url | stylesheet_tag }} 
  {{ 'jquery-3.5.1.min.js' | asset_url | script_tag }}    
  <script src="{{ 'password.js' | asset_url }}" defer="defer"></script>  
  {{ content_for_header }}

  <style>
    /* Global Reset & Base Styles */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      height: 100%;
      width: 100%;
      overflow-x: hidden;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background-color: #000000;
      color: #FFFFFF;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* Full Screen Password Page Layout */
    .template-password {
      height: 100vh;
      width: 100vw;
      position: relative;
      overflow-y: auto;
      overflow-x: hidden;
    }

    .password-page {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background-color: #000000;
    }

    /* Password Header with Login Link */
    .password-header {
      position: absolute;
      top: 1.5rem;
      right: 1.5rem;
      z-index: 100;
    }

    .password-header .js-modal-open-login-modal {
      padding: 0.75rem 1.5rem;
      background-color: transparent;
      border: 1px solid rgba(255, 255, 255, 0.3);
      color: #FFFFFF;
      text-decoration: none;
      font-size: 0.9rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      transition: all 0.3s ease;
      display: inline-block;
    }

    .password-header .js-modal-open-login-modal:hover {
      background-color: #FFFFFF;
      color: #000000;
      border-color: #FFFFFF;
    }

    /* Main Content Area - Full Screen */
    .password-main {
      flex: 1;
      display: flex;
      flex-direction: column;
      width: 100%;
    }

    .password-main__inner {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    /* Modal Styles */
    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: rgba(0, 0, 0, 0.95);
      z-index: 1000;
      opacity: 0;
      transition: opacity 0.3s ease;
      overflow-y: auto;
    }

    .modal--is-active {
      display: flex;
      opacity: 1;
    }

    .modal__inner {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 2rem;
    }

    .modal__centered {
      max-width: 500px;
      width: 100%;
      background-color: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 3rem 2.5rem;
      position: relative;
    }

    .modal__close {
      position: fixed;
      top: 1.5rem;
      right: 1.5rem;
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.3);
      color: #FFFFFF;
      width: 50px;
      height: 50px;
      cursor: pointer;
      font-size: 1.5rem;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1001;
    }

    .modal__close:before {
      content: "×";
      font-size: 2rem;
      line-height: 1;
    }

    .modal__close:hover {
      background-color: #FFFFFF;
      color: #000000;
      border-color: #FFFFFF;
      transform: rotate(90deg);
    }

    .password__form-heading {
      font-size: 1.3rem;
      font-weight: 400;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: #FFFFFF;
      margin-bottom: 2rem;
      text-align: center;
    }

    /* Modal Form Styles */
    .modal .input-group {
      display: flex;
      margin-bottom: 2rem;
      gap: 0;
    }

    .modal .input-group__field {
      flex: 1;
      padding: 1rem 1.5rem;
      background-color: #FFFFFF;
      border: 1px solid #FFFFFF;
      color: #000000;
      font-size: 1rem;
      outline: none;
    }

    .modal .input-group__field::placeholder {
      color: rgba(0, 0, 0, 0.5);
    }

    .modal .input-group__btn {
      display: flex;
    }

    .modal .dt-sc-btn {
      padding: 1rem 2rem;
      background-color: #000000;
      border: 1px solid #FFFFFF;
      color: #FFFFFF;
      font-size: 1rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.3s ease;
      white-space: nowrap;
    }

    .modal .dt-sc-btn:hover {
      background-color: #FFFFFF;
      color: #000000;
    }

    .modal p {
      text-align: center;
      color: rgba(255, 255, 255, 0.7);
      font-size: 0.9rem;
      margin-top: 1rem;
    }

    .modal p a {
      color: #FFFFFF;
      text-decoration: underline;
    }

    /* Error Messages */
    .errors,
    .form--success {
      background-color: rgba(255, 0, 0, 0.1);
      border: 1px solid rgba(255, 0, 0, 0.3);
      padding: 1rem;
      margin-bottom: 1.5rem;
      color: #FFFFFF;
      list-style: none;
    }

    .form--success {
      background-color: rgba(0, 255, 0, 0.1);
      border-color: rgba(0, 255, 0, 0.3);
    }

    .errors li,
    .form--success li {
      text-align: center;
    }

    /* Responsive Adjustments */
    @media (max-width: 768px) {
      .password-header {
        top: 1rem;
        right: 1rem;
      }

      .password-header .js-modal-open-login-modal {
        padding: 0.6rem 1rem;
        font-size: 0.8rem;
      }

      .modal__centered {
        padding: 2rem 1.5rem;
      }

      .modal__close {
        top: 1rem;
        right: 1rem;
        width: 45px;
        height: 45px;
      }

      .modal .input-group {
        flex-direction: column;
        gap: 1rem;
      }

      .modal .dt-sc-btn {
        width: 100%;
      }
    }

    /* Ensure content visibility */
    .password-main__inner > * {
      width: 100%;
    }
  </style>
</head>

<body class="template-password">
  <div class="password-page">
    <header class="password-header" role="banner">
      <a href="#LoginModal" class="js-modal-open-login-modal">
        {{ 'general.password_page.password_link' | t }} &rarr;
      </a>
    </header>

    <div class="password-main" role="main">
      <div class="password-main__inner">
        {{ content_for_layout }}
      </div>
    </div>
  </div>

  <div id="LoginModal" class="modal">
    <div class="modal__inner">
      <div class="modal__centered">
        <h4 class="password__form-heading">{{ 'general.password_page.login_form_heading' | t }}</h4>
        {% form 'storefront_password' %}
          {{ form.errors | default_errors }}
          <div class="input-group">
            <input type="password" 
                   name="password" 
                   id="Password" 
                   class="input-group__field" 
                   placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}">
            <span class="input-group__btn">
              <button type="submit" name="commit" class="dt-sc-btn">
                {{ 'general.password_page.login_form_submit' | t }}
              </button>
            </span>
          </div>
        {% endform %}
        <p>{{ 'general.password_page.admin_link_html' | t }}</p>
      </div>
    </div>
    <button type="button" class="modal__close js-modal-close" aria-label="Close"></button>
  </div>
</body>
</html>
