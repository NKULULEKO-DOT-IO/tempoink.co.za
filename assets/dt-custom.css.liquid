/* ========= MINIMALISTIC BLACK & WHITE DESIGN SYSTEM =============== */
/* Version 2.0 - Mobile-First | Monochrome | Clean */

:root {

  /* ===== TYPOGRAPHY (Roboto Throughout) ===== */

  /* All fonts use Roboto - No serif fonts */
  --DTFontTypo_Heading: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --DTFontTypo_Body: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --DTFontTypo_Custom: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;

  /* Font Weights */
  --font-weight-header: 700;  /* Bold for headlines */
  --font-weight-body: 400;    /* Regular for body */
  --font-weight-body--bold: 700;
  --font-weight-body--bolder: 900;
  --font-style-header: normal;
  --font-style-body: normal;
  --font-style-additional: normal;
  --font-weight-additional: 500;

  /* Fluid Typography - Mobile First */
  --font-size-body: clamp(16px, 2vw, 18px);
  --font-size-header: clamp(32px, 7vw, 56px);
  --font-size-additional: clamp(16px, 2vw, 18px);

  /* Heading Sizes - Responsive */
  --DTFontSize_H1: clamp(32px, 7vw, 56px);
  --DTFontSize_H2: clamp(24px, 5vw, 40px);
  --DTFontSize_H3: clamp(20px, 4vw, 32px);
  --DTFontSize_H4: clamp(18px, 3vw, 24px);
  --DTFontSize_H5: clamp(16px, 2.5vw, 20px);
  --DTFontSize_H6: clamp(14px, 2vw, 18px);

  /* Line Heights - Optimized */
  --DT_Heading_Line_Height: 1.2em;
  --DT_Body_Line_Height: 1.5em; /* Changed from 2em for better mobile */

  /* ===== COLORS (Black & White Only) ===== */

  /* Brand Colors - Strict Monochrome */
  --color-black: #000000;
  --color-white: #FFFFFF;
  --color-gray-light: #F5F5F5;
  --color-gray-border: #E0E0E0;
  --color-gray-text: #333333;

  /* Primary Colors */
  --DTPrimaryColor: #000000;
  --DTSecondaryColor: #F5F5F5;
  --DTTertiaryColor: #E0E0E0;
  --DTBodyBGColor: #FFFFFF;
  --DTOverlayColor: rgba(0, 0, 0, 0.5);
  --swiper-theme-color: #000000 !important;

  /* Text Colors */
  --DTColor_Body: #333333;
  --DTColor_Heading: #000000;
  --DTColor_Border: #E0E0E0;
  --DTLinkColor: #000000;
  --DTLinkHoverColor: #333333;

  /* Product Colors */
  --DT_product_bg_color: #FFFFFF;
  --DT_product_text_color: #333333;
  --DT_product_title_color: #000000;
  --DT_product_title_hover_color: #333333;

  /* Blog Section - Monochrome */
  --DT_Blog_Border_Radius: 0px;
  --DT_Blog_Gutter_Width: 24px;
  --DT_Blog_BG_Color: #FFFFFF;
  --DT_Blog_Link_Color: #000000;
  --DT_Blog_Link_Hover_Color: #333333;
  --DT_Blog_Text_Color: #333333;
  --DT_Blog_Icon_Color: #000000;
  --DT_Blog_Button_BG_Color: #000000;
  --DT_Blog_Button_Text_Color: #FFFFFF;
  --DT_Blog_Button_BG_Hover_Color: #FFFFFF;
  --DT_Blog_Button_Text_Hover_Color: #000000;

  /* Blog Overlay (same as regular) */
  --DT_Blog_Link_Color_Overlay: #000000;
  --DT_Blog_Link_Hover_Color_Overlay: #333333;
  --DT_Blog_Text_Color_overlay: #333333;
  --DT_Blog_Icon_Color_overlay: #000000;
  --DT_Blog_Button_BG_Color_overlay: #000000;
  --DT_Blog_Button_Text_Color_overlay: #FFFFFF;
  --DT_Blog_Button_BG_Hover_Color_overlay: #FFFFFF;
  --DT_Blog_Button_Text_Hover_Color_overlay: #000000;

  /* ===== BUTTONS (Black & White) ===== */
  --DTPadding_Btn: 14px 32px;
  --DT_Button_BG_Color: #000000 !important;
  --DT_Button_Text_Color: #FFFFFF;
  --DT_Button_BG_Hover_Color: #FFFFFF;
  --DT_Button_border_Color: #000000;
  --DT_Button_hover_border_Color: #000000;
  --DT_Button_Text_Hover_Color: #000000;
  --DT_Button_Border_Radius: 0px;
  --DT_Button_border_width: 2px;

  /* ===== SPACING (8px Grid System) ===== */
  --space-unit: 8px;
  --space-xs: 8px;
  --space-sm: 16px;
  --space-md: 24px;
  --space-lg: 32px;
  --space-xl: 48px;
  --space-2xl: 64px;
  --space-3xl: 96px;

  /* Section Spacing - Mobile First */
  --section-padding-mobile: 48px 16px;
  --section-padding-tablet: 64px 32px;
  --section-padding-desktop: 96px 48px;

  /* Grid Gaps */
  --DTGutter_Width: clamp(16px, 2.5vw, 24px);
  --grid-gap-mobile: 16px;
  --grid-gap-tablet: 24px;
  --grid-gap-desktop: 32px;

  /* ===== BORDERS & RADIUS ===== */
  --DTRadius: 0px;
  --overall_border_radius: 0px;

  /* ===== CONTAINERS (Mobile First) ===== */
  --DTContainer: 1200px;
  --DT_Lap_Container: 1024px;
  --DT_Tab_Container: 768px;
  --container-padding-mobile: 16px;
  --container-padding-tablet: 32px;
  --container-padding-desktop: 48px;

  /* ===== INTERACTIONS ===== */
  --DTBaseTransition: 0.2s ease;
  --transition-fast: 0.15s ease;
  --transition-base: 0.2s ease;

  /* ===== ACCESSIBILITY ===== */
  --touch-target-min: 44px; /* iOS minimum */

  /* Remove box shadows - Minimalism */
  --DTboxShadow: none;
  --DTboxShadow_light: none;
  --DTboxShadowcolor: transparent;
  --DTboxShadowcolor_light: transparent;

  /* ===== FORMS ===== */
  --DTInputPadding: 12px 16px;
  --DTInputBackground: #FFFFFF;
  --DTform_BG: #F5F5F5;
  --input_bg: #FFFFFF;
  --form_bg: #F5F5F5;

}

