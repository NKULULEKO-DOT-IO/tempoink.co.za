/* ========= MOBILE-FIRST UTILITIES & ENHANCEMENTS =============== */
/* Version 2.0 - Accessibility | Touch-Friendly | Performance */

/* ===== TOUCH TARGETS (iOS 44px minimum) ===== */
button,
.button,
.dt-sc-btn,
a.button,
input[type="button"],
input[type="submit"],
.site-header__links a,
.mobile-nav a {
  min-height: var(--touch-target-min);
  min-width: var(--touch-target-min);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* ===== TYPOGRAPHY ENHANCEMENTS ===== */

/* All headings use Roboto Bold */
h1, h2, h3, h4, h5, h6,
.h1, .h2, .h3, .h4, .h5, .h6 {
  font-family: var(--DTFontTypo_Heading) !important;
  font-weight: var(--font-weight-header) !important;
  line-height: var(--DT_Heading_Line_Height) !important;
  color: var(--DTColor_Heading) !important;
  letter-spacing: -0.02em;
}

/* Body text optimization */
body, p, li, td, th {
  font-family: var(--DTFontTypo_Body) !important;
  font-weight: var(--font-weight-body) !important;
  line-height: var(--DT_Body_Line_Height) !important;
  color: var(--DTColor_Body) !important;
}

/* Buttons get uppercase treatment */
button, .button, .dt-sc-btn {
  font-family: var(--DTFontTypo_Body) !important;
  font-weight: 500 !important;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

/* ===== MOBILE-FIRST RESPONSIVE TYPOGRAPHY ===== */

/* Base font size adjustment for mobile */
@media (max-width: 767px) {
  html {
    font-size: 16px;
  }
  
  body {
    font-size: 16px !important;
    line-height: 1.5 !important;
  }

  /* Reduce excessive heading sizes on mobile */
  h1, .h1 {
    font-size: clamp(32px, 7vw, 40px) !important;
    margin-bottom: 16px !important;
  }

  h2, .h2 {
    font-size: clamp(24px, 5vw, 32px) !important;
    margin-bottom: 12px !important;
  }

  h3, .h3 {
    font-size: clamp(20px, 4vw, 28px) !important;
  }

  /* Tighter spacing on mobile */
  p {
    margin-bottom: 16px !important;
  }
}

/* ===== MOBILE NAVIGATION ENHANCEMENTS ===== */

@media (max-width: 767px) {
  /* Ensure hamburger menu is touch-friendly */
  .menu-trigger {
    min-width: 48px !important;
    min-height: 48px !important;
    padding: 12px !important;
  }

  /* Mobile menu links */
  .mobile-nav-container a {
    min-height: 48px !important;
    padding: 14px 20px !important;
    font-size: 16px !important;
    display: flex !important;
    align-items: center;
  }

  /* Header padding optimization */
  .site-header {
    padding: 12px 16px !important;
  }
}

/* ===== BUTTON ENHANCEMENTS (Black & White) ===== */

/* Primary Button - Black */
.dt-sc-btn-primary,
.button-primary,
button[type="submit"],
input[type="submit"] {
  background: #000000 !important;
  color: #FFFFFF !important;
  border: 2px solid #000000 !important;
  padding: 14px 32px !important;
  transition: all var(--transition-base) !important;
}

.dt-sc-btn-primary:hover,
.button-primary:hover,
button[type="submit"]:hover {
  background: #FFFFFF !important;
  color: #000000 !important;
  border-color: #000000 !important;
}

/* Secondary Button - White */
.dt-sc-btn-secondary,
.button-secondary {
  background: #FFFFFF !important;
  color: #000000 !important;
  border: 2px solid #000000 !important;
  padding: 14px 32px !important;
}

.dt-sc-btn-secondary:hover,
.button-secondary:hover {
  background: #000000 !important;
  color: #FFFFFF !important;
}

/* Mobile button optimization */
@media (max-width: 767px) {
  button, .button, .dt-sc-btn {
    padding: 12px 24px !important;
    font-size: 14px !important;
    min-height: 44px !important;
  }
}

/* ===== FORM ENHANCEMENTS ===== */

input[type="text"],
input[type="email"],
input[type="tel"],
input[type="password"],
input[type="search"],
textarea,
select {
  font-size: 16px !important; /* Prevents zoom on iOS */
  font-family: var(--DTFontTypo_Body) !important;
  background: #FFFFFF !important;
  border: 2px solid #E0E0E0 !important;
  color: #000000 !important;
  padding: 12px 16px !important;
  transition: border-color var(--transition-fast) !important;
  border-radius: 0 !important;
}

input:focus,
textarea:focus,
select:focus {
  border-color: #000000 !important;
  outline: none !important;
}

input::placeholder,
textarea::placeholder {
  color: #999999 !important;
}

/* ===== CARD/PRODUCT GRID ENHANCEMENTS ===== */

.product-item,
.product-grid-item,
.card {
  background: #FFFFFF !important;
  border: 1px solid #E0E0E0 !important;
  transition: border-color var(--transition-base) !important;
}

.product-item:hover,
.product-grid-item:hover,
.card:hover {
  border-color: #000000 !important;
}

/* Remove shadows - Minimalism */
.product-item,
.product-grid-item,
.card,
.site-header {
  box-shadow: none !important;
}

/* ===== MOBILE-FIRST GRID SYSTEM ===== */

/* 2-column grid on mobile for products */
@media (max-width: 767px) {
  .product-grid,
  .collection-products {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 16px !important;
  }
}

/* 3-column on tablet */
@media (min-width: 768px) and (max-width: 1023px) {
  .product-grid,
  .collection-products {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr) !important;
    gap: 24px !important;
  }
}

/* 4-column on desktop */
@media (min-width: 1024px) {
  .product-grid,
  .collection-products {
    display: grid !important;
    grid-template-columns: repeat(4, 1fr) !important;
    gap: 32px !important;
  }
}

/* ===== ACCESSIBILITY ENHANCEMENTS ===== */

/* Focus visible for keyboard navigation */
*:focus-visible {
  outline: 2px solid #000000 !important;
  outline-offset: 2px !important;
}

/* Remove outline for mouse users */
*:focus:not(:focus-visible) {
  outline: none !important;
}

/* Screen reader only class */
.sr-only {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}

/* ===== MOBILE PERFORMANCE OPTIMIZATIONS ===== */

/* Reduce motion for users who prefer it */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* ===== UTILITY CLASSES ===== */

/* Mobile-first spacing utilities */
.mt-mobile { margin-top: var(--space-md); }
.mb-mobile { margin-bottom: var(--space-md); }
.py-mobile { padding-top: var(--space-md); padding-bottom: var(--space-md); }
.px-mobile { padding-left: var(--space-sm); padding-right: var(--space-sm); }

@media (min-width: 768px) {
  .mt-mobile { margin-top: var(--space-lg); }
  .mb-mobile { margin-bottom: var(--space-lg); }
  .py-mobile { padding-top: var(--space-xl); padding-bottom: var(--space-xl); }
  .px-mobile { padding-left: var(--space-lg); padding-right: var(--space-lg); }
}

/* Text alignment utilities */
.text-mobile-center {
  text-align: center;
}

@media (min-width: 768px) {
  .text-mobile-center {
    text-align: left;
  }
}

/* Hide/show utilities */
.mobile-only {
  display: block;
}

.desktop-only {
  display: none;
}

@media (min-width: 768px) {
  .mobile-only {
    display: none;
  }
  
  .desktop-only {
    display: block;
  }
}

/* ===== END MOBILE-FIRST UTILITIES ===== */
